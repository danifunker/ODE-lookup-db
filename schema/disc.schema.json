{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danifunker/ODE-lookup-db/schema/disc.schema.json",
  "title": "Redump Disc",
  "description": "One disc entry, schema v3 (redump.info). Tracks carry physical layout only; per-file hashes live in `files`. Forward-compatible: readers must ignore unknown fields; writers omit null/unknown values.",
  "type": "object",
  "required": ["redump_id", "system", "title", "tracks", "files", "redump_url", "schema_version"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "redump_id": {
      "type": "integer",
      "minimum": 1
    },
    "system": {
      "type": "string",
      "enum": ["pc", "mac"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "foreign_title": {
      "type": ["string", "null"]
    },
    "region": {
      "type": "array",
      "items": { "type": "string" }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}$",
        "description": "ISO 639-1 code, or 'zz' for unmapped"
      }
    },
    "languages_raw": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Original language strings as scraped from redump"
    },
    "edition": { "type": ["string", "null"] },
    "version": { "type": ["string", "null"] },
    "serials": {
      "type": "array",
      "items": { "type": "string" }
    },
    "barcode": { "type": ["string", "null"] },
    "catalog": {
      "type": ["string", "null"],
      "description": "Catalog number from the gamecomments Metadata row; null for all-zero placeholders."
    },
    "category": { "type": ["string", "null"] },
    "media": {
      "type": ["string", "null"],
      "description": "Physical media type as reported by redump (CD, DVD-5, DVD-9, BD-25, etc.)"
    },
    "pvd": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "volume_identifier": { "type": ["string", "null"] },
        "system_identifier": { "type": ["string", "null"] },
        "volume_set_identifier": { "type": ["string", "null"] },
        "publisher_identifier": { "type": ["string", "null"] },
        "data_preparer_identifier": { "type": ["string", "null"] },
        "application_identifier": { "type": ["string", "null"] },
        "creation_date": { "type": ["string", "null"] },
        "modification_date": { "type": ["string", "null"] },
        "expiration_date": { "type": ["string", "null"] },
        "effective_date": { "type": ["string", "null"] }
      }
    },
    "tracks": {
      "type": "array",
      "description": "Physical track layout. Empty for media with no track table (e.g. DVDs). Per-file hashes live in `files`.",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["number"],
        "additionalProperties": true,
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "type": { "type": "string", "enum": ["data", "audio"] },
          "pregap": { "type": ["string", "null"], "description": "MSF timecode (mm:ss:ff)" },
          "length": { "type": ["string", "null"], "description": "MSF timecode (mm:ss:ff)" },
          "sectors": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "files": {
      "type": "array",
      "description": "Dumped files with their hashes (the .cue plus one file per track/image).",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["filename"],
        "additionalProperties": true,
        "properties": {
          "filename": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "crc32": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{8}$"
          },
          "md5": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{32}$"
          },
          "sha1": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "cuesheet_sha1": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "disc_structure": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "layer_break": { "type": ["integer", "null"] },
        "ring_mastering_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mould_sid": { "type": ["string", "null"] },
        "ifpi": { "type": ["string", "null"] }
      }
    },
    "dumpers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "date_added": { "type": ["string", "null"] },
    "date_last_modified": { "type": ["string", "null"] },
    "redump_url": {
      "type": "string",
      "pattern": "^https?://redump\\.(info|org)/disc/[0-9]+/?$"
    },
    "scraped_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of when this row was last fetched/parsed"
    },
    "artwork": {
      "description": "Reserved for future artwork archival. Omit or set null until populated.",
      "type": ["object", "null"]
    }
  }
}
